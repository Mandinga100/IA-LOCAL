# Configuración de Variables de Entorno para AnythingLLM Multi-User Docker
# Plataforma IA Local - Windows 10 Pro 64-bit

SERVER_PORT=3001
STORAGE_DIR=/app/server/storage
DISABLE_TELEMETRY=true
DISABLE_PRIVACY_WARNING=true

# Seguridad JWT y Tokens
JWT_SECRET=generar_un_hash_aleatorio_seguro_sha256_aqui

# Conexión con los servicios locales en Windows 10 Host
OLLAMA_BASE_URL=http://host.docker.internal:11434
GATEWAY_BASE_URL=http://host.docker.internal:8000/v1

# Multi-Usuario y Gobernanza
# Administrador Inicial: Se define en el primer acceso en http://localhost:3001
# Roles:
# - Admin: Control global del sistema, modelos, base vectorial y llaves
# - Manager: Creación de workspaces departamentales y gestión de usuarios
# - Default User: Miembros de equipo con acceso exclusivo a sus workspaces
