# ==============================================================================
# Git Ignore - Plataforma IA Local / AnythingLLM Monorepo
# ==============================================================================

# Node.js Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Python Environments & Cache
.venv/
**/.venv/
env/
venv/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Local Environment Variables & Secrets
.env
**/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example
!**/.env.docker.example

# AI Model Weights & LLM Binaries (>50MB / GitHub Limit 100MB)
*.gguf
**/*.gguf
*.bin
**/*.bin
*.safetensors
**/*.safetensors
*.onnx
*.pt
poc_llama_server/
**/poc_llama_server/
AnythingLLM/Base/poc_llama_server/

# Large Backups & Binary Archives (>50MB / GitHub Limit 100MB)
*.zip
**/*.zip
*.tar.gz
**/*.tar.gz
*.tar
**/*.tar
*.7z
*.rar
backup/
**/backup/
AnythingLLM/backup/
AnythingLLM/Base/backup/

# Local Databases & Vector Stores
server/storage/*.db
server/storage/*.db-journal
server/storage/lancedb/
AnythingLLM/server/storage/*.db
AnythingLLM/server/storage/*.db-journal
AnythingLLM/server/storage/lancedb/

# Build & Dist Outputs
dist/
build/
out/
.next/

# IDE & OS Metadata
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp
.idea/

# Local Logs
*.log
logs/
AnythingLLM/logs/*.log
AnythingLLM/Base/logs/*.log
